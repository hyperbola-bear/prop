# Database
DATABASE_URL=postgres://proppy:proppy@localhost:5432/proppy

# Auth
AUTH_SECRET=replace-with-local-auth-secret
JWT_SECRET=replace-with-local-jwt-secret
AUTH_MYINFO_ENABLED=false

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=proppy-photos

# Mail
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@proppy.test

# OneMap (user provides; falls back to seed data only if blank)
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Feature flags
DEV_OTP_BYPASS=true
