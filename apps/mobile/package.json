{
  "name": "@proppy/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "build:shared": "npm run build -w @proppy/shared",
    "prestart": "npm run build:shared",
    "start": "node ../../scripts/forward-signals.mjs expo start",
    "preweb": "npm run build:shared",
    "web": "node ../../scripts/forward-signals.mjs expo start --web",
    "prebuild": "npm run build:shared",
    "build": "expo export -p web --clear",
    "lint": "eslint . --max-warnings=0",
    "pretypecheck": "npm run build:shared",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build:shared",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.11",
    "@proppy/shared": "^0.0.0",
    "@tanstack/react-query": "^5.101.0",
    "expo": "~56.0.3",
    "expo-constants": "^56.0.14",
    "expo-image-picker": "~56.0.15",
    "expo-linking": "^56.0.11",
    "expo-router": "56.2.5",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "leaflet": "1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "5.0.0",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.25.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21",
    "@types/react": "~19.2.2"
  }
}
