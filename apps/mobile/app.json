{
  "expo": {
    "name": "Proppy Mobile",
    "slug": "proppy-mobile",
    "scheme": "proppy",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
