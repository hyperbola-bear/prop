{
  "name": "@proppy/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./schema/index.ts",
  "types": "./schema/index.ts",
  "exports": {
    ".": {
      "types": "./schema/index.ts",
      "default": "./schema/index.ts"
    },
    "./schema": {
      "types": "./schema/index.ts",
      "default": "./schema/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx ./seed/index.ts",
    "db:reset": "node ./scripts/reset.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1052.0",
    "argon2": "^0.44.0",
    "drizzle-orm": "0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.8",
    "tsx": "^4.22.3"
  }
}
