{
  "name": "@proppy/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./api-client": {
      "types": "./dist/api-client/index.d.ts",
      "default": "./dist/api-client/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "default": "./dist/format/index.js"
    },
    "./otp": {
      "types": "./dist/otp/index.d.ts",
      "default": "./dist/otp/index.js"
    },
    "./myinfo-mock": {
      "types": "./dist/myinfo-mock/index.d.ts",
      "default": "./dist/myinfo-mock/index.js"
    },
    "./onemap": {
      "types": "./dist/onemap/index.d.ts",
      "default": "./dist/onemap/index.js"
    },
    "./ssrf-guard": {
      "types": "./dist/ssrf-guard/index.d.ts",
      "default": "./dist/ssrf-guard/index.js"
    },
    "./search-query": {
      "types": "./dist/search-query/index.d.ts",
      "default": "./dist/search-query/index.js"
    },
    "./scam-detection": {
      "types": "./dist/scam-detection/index.d.ts",
      "default": "./dist/scam-detection/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@proppy/db": "0.0.0",
    "argon2": "^0.44.0",
    "drizzle-orm": "0.45.2",
    "postgres": "^3.4.7",
    "zod": "4.4.3"
  }
}
